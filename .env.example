# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring. .env faylini HECH QACHON GitHub'ga yuklamang.
PORT=3000
NODE_ENV=development

# MongoDB Atlas ulanish manzili (mongodb+srv://...)
MONGODB_URI=mongodb+srv://<db_username>:FJj58VmyX7PGzAyx@cluster0.sdam4l6.mongodb.net/telefon_market

# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=8fff003e984cc8e830dcca70c7bf4f734ee6ba92dbd8057b1b80a548ff23e0e6cd05c0942530bfe02e0b21092d73a31b
ACCESS_TOKEN_EXPIRES=7d

# Frontend manzil(lar)i (CORS). Bir nechta bo'lsa vergul bilan: https://sayt.uz,https://www.sayt.uz
CLIENT_ORIGIN=http://localhost:5173

# Yuklangan rasmlar uchun ommaviy backend manzili va papka
PUBLIC_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# Hosting (Render, Railway, Nginx) ortida bo'lsa true qiling
TRUST_PROXY=false

# Mijozdan olinadigan kuryer narxi (so'm) va bir dona uchun minimal foyda (so'm). 0 = o'chiq
DELIVERY_FEE_COURIER=0
MIN_PROFIT=0

# Telegram (ixtiyoriy). Bo'sh qolsa, bildirishnoma yuborilmaydi — buyurtma baribir saqlanadi.
# Token @BotFather'dan, chat id — adminlar guruhi yoki kanali.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Google OAuth Client ID (Google Cloud Console -> APIs & Services -> Credentials)
